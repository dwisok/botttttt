# SENTINEL landing — optional backend connection.
# Leave unset to run the landing standalone (the live globe/monitor use a built-in simulation).
# Set these to wire the Operations section to the real backend API (apps/api).

# Base URL of the running api service (apps/api). e.g. http://localhost:3000
VITE_API_URL=

# API key accepted by the backend (apps/api API_KEYS). Defaults to the dev key.
VITE_API_KEY=dev-key-please-change
