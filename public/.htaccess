# Static hosting for the keeper front (no Node / npm / pnpm / corepack at runtime,
# so the ERR_VM_DYNAMIC_IMPORT_CALLBACK_MISSING corepack crash cannot happen).
#
# "/" serves the keeper landing (index.html). The live demo is at /demo.

DirectoryIndex index.html

RewriteEngine On

# Extension-less path -> .html when that file exists (e.g. /demo)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
